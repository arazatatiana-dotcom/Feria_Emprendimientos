# ---- Servidor ----
PORT=3000
# Cadena larga y aleatoria (firma de sesiones). ¡Cámbiela!
APP_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria
# URL pública de la app (se usa en los correos)
APP_URL=http://localhost:3000
TZ_OFFSET=-05:00

# ---- Base de datos ----
# DB_DRIVER=mssql  -> SQL Server interno o Azure SQL
# DB_DRIVER=sqlite -> modo demo/pruebas (archivo local, sin instalar nada)
DB_DRIVER=mssql
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FeriaEmprendedores
DB_USER=feria_app
DB_PASSWORD=
# Azure SQL requiere true. Servidor interno con certificado propio: DB_TRUST_CERT=true
DB_ENCRYPT=true
DB_TRUST_CERT=false
SQLITE_FILE=./data/feria.db

# ---- Super administrador inicial (se crea al primer arranque si no existe) ----
SUPERADMIN_CEDULA=0000000000
SUPERADMIN_PASSWORD=Cambiar.2026

# ---- Correo (SMTP). Para Microsoft 365: smtp.office365.com, puerto 587 ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Feria de Emprendedores <feria@suempresa.com>"
